# ==========================================================
# Plantilla de variables de entorno — tfm-risk-platform
# ----------------------------------------------------------
# Copia este archivo como .env y rellena los valores reales.
# El .env real NUNCA debe subirse al repositorio (ver .gitignore).
#
# NOTA: en este laboratorio, Elasticsearch se ejecuta sin
# seguridad (xpack.security.enabled=false) por tratarse de un
# entorno aislado. Las claves de API se configuran DENTRO de
# n8n (credenciales cifradas en su volumen), no en este archivo.
# Se documentan aquí para dejar constancia de las dependencias.
# ==========================================================

# --- n8n ---
GENERIC_TIMEZONE=Europe/Madrid
N8N_HOST=n8n.local
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.local/
WEBHOOK_URL=https://n8n.local/

# --- Elasticsearch ---
# URL interna usada por los nodos de n8n dentro de la red Docker.
# Debe ser el nombre de servicio, NO localhost.
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- Claves de API (configurar como credenciales dentro de n8n) ---
# Anthropic: nodo Anthropic Chat Model (generación de rationale/remediación)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVD: consultas a la API de NIST por CPE
NVD_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
